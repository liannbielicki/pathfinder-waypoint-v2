# Railway API and workers
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/waypoint
LLM_API_KEY=replace-me
N8N_CONTEXT_URL=https://replace-me.example/webhook/context
N8N_TOKEN=replace-me
# The n8n context flow can take 10-15 minutes per call under load (optional,
# defaults 900 / 3). MAX_CONCURRENT caps simultaneous flow executions so the
# workers don't overload Snowflake/Iterable behind the webhook.
N8N_TIMEOUT_SECONDS=900
N8N_MAX_CONCURRENT=3
PERSONA_URL=https://replace-me.example/personas
PERSONA_TOKEN=replace-me
HANDOFF_URL=https://hcp-email-review.vercel.app/api/pathfinder/intake
HANDOFF_TOKEN=replace-me
# Vercel Deployment Protection bypass secret for the LCM intake app — separate
# from HANDOFF_TOKEN, issued by Allison's team out-of-band (DM/1Password).
BYPASS_TOKEN=replace-me
RUN_COST_USD=25.00
DAY_COST_USD=500.00
WORKER_COUNT=4
# Fleet-wide cap on concurrent Anthropic calls (optional, default 4). Set from
# the model tier's rate limit, not the agent count; raise it and watch for
# *_rate_limited job failures to find the safe ceiling.
MAX_LLM_IN_FLIGHT=4
KILL_SWITCH=false
MODEL_FAST=replace-me
MODEL_DEEP=replace-me
# Machine token for the n8n outcome-ingestion flow: POST /api/outcomes and
# GET /api/funnel/worklist (bare run_id/pro_id pairs). Scoped deliberately: it
# cannot create runs, read run detail, read the full funnel (themes/org_ids),
# or hit the kill switch, so n8n never needs APP_PASSWORD. Leave unset to keep that endpoint
# cookie-only. Generate with: openssl rand -hex 32
OUTCOMES_TOKEN=

APP_PASSWORD=replace-me
SESSION_KEY=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO

# Vercel frontend; this value is not secret
API_BASE_URL=https://replace-me.up.railway.app
