# Railway API and workers
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/waypoint
LLM_API_KEY=replace-me
N8N_CONTEXT_URL=https://replace-me.example/webhook/context
N8N_TOKEN=replace-me
PERSONA_URL=https://replace-me.example/personas
PERSONA_TOKEN=replace-me
HANDOFF_URL=https://replace-me.example/handoff
HANDOFF_TOKEN=replace-me
RUN_COST_USD=25.00
DAY_COST_USD=500.00
WORKER_COUNT=4
# Fleet-wide cap on concurrent Anthropic calls (optional, default 4). Set from
# the model tier's rate limit, not the agent count; raise it and watch for
# *_rate_limited job failures to find the safe ceiling.
MAX_LLM_IN_FLIGHT=4
KILL_SWITCH=false
MODEL_FAST=replace-me
MODEL_DEEP=replace-me
APP_PASSWORD=replace-me
SESSION_KEY=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO

# Vercel frontend; this value is not secret
API_BASE_URL=https://replace-me.up.railway.app
