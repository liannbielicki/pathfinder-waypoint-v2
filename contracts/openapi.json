{
  "components": {
    "schemas": {
      "ExposureIn": {
        "description": "One exposure registration. Arm \"A\" is the treated recommendation; arm\n\"B\" is the control/neutral exposure (no WinnerRow required). A\nwinner-linked item derives identity from the winner \u2014 caller identity\nfields are ignored there.",
        "properties": {
          "arm": {
            "anyOf": [
              {
                "enum": [
                  "A",
                  "B"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arm"
          },
          "channel": {
            "default": "",
            "title": "Channel",
            "type": "string"
          },
          "exposure_id": {
            "minLength": 1,
            "title": "Exposure Id",
            "type": "string"
          },
          "item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          },
          "item_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Version"
          },
          "org_id": {
            "default": "",
            "title": "Org Id",
            "type": "string"
          },
          "pro_id": {
            "default": "",
            "title": "Pro Id",
            "type": "string"
          },
          "recommendation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Id"
          },
          "send_status": {
            "default": "unknown",
            "enum": [
              "unknown",
              "pending",
              "confirmed",
              "failed"
            ],
            "title": "Send Status",
            "type": "string"
          },
          "sent_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          }
        },
        "required": [
          "exposure_id"
        ],
        "title": "ExposureIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
