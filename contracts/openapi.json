      "TouchOutcomeIn": {
        "description": "One observed exposure/outcome record.\n\nLCM Personalization turns Waypoint's theme into an approved Housecall Pro\nSMS and sends it. It is not the measurement authority; outcome sources\nreport exposure and events back to Waypoint.\n\nV3 authority rules: attribution identity (pro, org, item, arm) comes ONLY\nfrom the winner/exposure records \u2014 callers cannot supply it, and any\ncaller-sent identity or returned_* horizon field is dropped at the wire.\nReturn horizons are derived from first_return_at against a confirmed send,\nor resolved by the checkpoint sweep \u2014 never asserted by a caller.",
        "properties": {
          "channel": {
            "default": "",
            "title": "Channel",
            "type": "string"
          },
          "clicked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clicked"
          },
          "delivered": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivered"
          },
          "exposure_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exposure Id"
          },
          "first_return_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Return At"
          },
          "org_id": {
            "default": "",
            "title": "Org Id",
            "type": "string"
          },
          "pro_id": {
            "default": "",
            "title": "Pro Id",
            "type": "string"
          },
          "recommendation_id": {
            "minLength": 1,
            "title": "Recommendation Id",
            "type": "string"
          },
          "replied": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replied"
          },
          "send_confirmed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Send Confirmed At"
          },
          "send_status": {
            "default": "unknown",
            "enum": [
              "unknown",
              "pending",
              "confirmed",
              "failed"
            ],
            "title": "Send Status",
            "type": "string"
          },
          "sent_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "unsubscribed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unsubscribed"
          }
        },
        "required": [
          "recommendation_id",
          "source"
        ],
        "title": "TouchOutcomeIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
