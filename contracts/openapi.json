          "audience_query",
          "audience_run",
          "channels"
        ],
        "title": "RunCreate",
        "type": "object"
      },
      "RunDetail": {
        "properties": {
          "agents_in_flight": {
            "title": "Agents In Flight",
            "type": "integer"
          },
          "audience_query": {
            "title": "Audience Query",
            "type": "string"
          },
          "audience_run": {
            "title": "Audience Run",
            "type": "string"
          },
          "candidates": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Candidates",
            "type": "array"
          },
          "channels": {
            "items": {
              "type": "string"
            },
            "title": "Channels",
            "type": "array"
          },
          "config_version": {
            "title": "Config Version",
            "type": "string"
          },
          "cost_limit_usd": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cost Limit Usd",
            "type": "string"
          },
          "cost_reserved_usd": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cost Reserved Usd",
            "type": "string"
          },
          "cost_spent_usd": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cost Spent Usd",
            "type": "string"
