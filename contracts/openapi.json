            "type": "object"
          },
          "measurements": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Measurements",
            "type": "array"
          },
          "pro_ids": {
            "items": {
              "type": "string"
            },
            "title": "Pro Ids",
            "type": "array"
          },
          "stages": {
            "additionalProperties": true,
            "title": "Stages",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "stop_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          },
          "winners": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Winners",
            "type": "array"
          }
        },
        "required": [
          "id",
          "status",
          "pro_ids",
          "audience_query",
          "audience_run",
          "channels",
          "config_version",
          "loop_config",
          "cost_limit_usd",
          "cost_reserved_usd",
          "cost_spent_usd",
          "stop_reason",
          "created_at",
          "journey_window",
          "stages",
          "candidates",
          "winners",
          "measurements",
          "handoffs",
