{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "action_console_audience",
  "description": "Legacy Action Console audience shape: a labelled segment defined by filters, with a factor summary and per-org evidence rows. The V2 packet includes only a synthetic shape fixture; production suppression and lineage require a separately approved upstream contract.",
  "type": "object",
  "required": [
    "audience_id",
    "label",
    "filters",
    "factor_summary",
    "org_uuid_evidence",
    "extract_manifest"
  ],
  "properties": {
    "audience_id": { "type": "string" },
    "label": { "type": "string" },
    "filters": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "factor_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "source"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "org_uuid_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["org_uuid", "matched_factors", "evidence_source"],
        "properties": {
          "org_uuid": { "type": "string" },
          "org_id": { "type": "string" },
          "matched_factors": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "evidence_source": { "type": "string" },
          "observed_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "extract_manifest": {
      "type": "object",
      "required": ["source_kind", "row_count", "query_hash"],
      "properties": {
        "source_kind": { "type": "string" },
        "source_table": { "type": "string" },
        "row_count": { "type": "integer", "minimum": 0 },
        "universe_row_count": { "type": "integer", "minimum": 0 },
        "query_hash": { "type": "string" },
        "observed_at": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
